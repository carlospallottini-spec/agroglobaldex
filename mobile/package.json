{
  "name": "agroglobaldex-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "AgroGlobalDex — app nativa Android/iOS (wrapper Capacitor del sitio https://agroglobaldex.com)",
  "scripts": {
    "sync": "cap sync",
    "copy": "cap copy",
    "assets": "capacitor-assets generate --assetPath assets --iconBackgroundColor '#05080A' --iconBackgroundColorDark '#05080A' --splashBackgroundColor '#05080A' --splashBackgroundColorDark '#05080A'",
    "add:android": "cap add android",
    "add:ios": "cap add ios",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "run:android": "cap run android",
    "build:android": "cap sync android && cd android && ./gradlew bundleRelease",
    "build:apk": "cap sync android && cd android && ./gradlew assembleRelease",
    "build:apk-debug": "cap sync android && cd android && ./gradlew assembleDebug",
    "doctor": "cap doctor"
  },
  "dependencies": {
    "@capacitor/android": "8.4.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/browser": "8.0.4",
    "@capacitor/core": "8.4.2",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.4.2",
    "@capacitor/keyboard": "8.0.5",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.3"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.4.2",
    "typescript": "5.6.3"
  }
}
